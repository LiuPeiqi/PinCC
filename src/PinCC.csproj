<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PinCC</RootNamespace>
    <AssemblyName>PinCC</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>pincc.ico</ApplicationIcon>
    <StartupObject>PinCC.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>1.0.1</Version>
    <Product>Pin Carbon Copy</Product>
    <AssemblyTitle>PinCC</AssemblyTitle>
    <Description>Pin Carbon Copy（PinCC）— 桌面悬浮卡片</Description>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="pincc.ico" />
    <!-- Runner profiles and skills are data shared with the Mac app: repo folder builtin/, embedded as "builtin/…". -->
    <EmbeddedResource Include="..\builtin\**\*.json;..\builtin\**\*.md" LogicalName="builtin/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
