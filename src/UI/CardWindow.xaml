<Window x:Class="PinCC.UI.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinCC" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual" SizeToContent="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource Ui.Font}" FontSize="14">
    <!-- The window rect IS the card: no margin, no shadow; a 1 px stroke separates it from the desktop. -->
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1">
        <Grid x:Name="Inner">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rendered markdown (view) and raw source (edit) share one clipped viewport: never a scrollbar. -->
            <Grid x:Name="Viewport" Margin="12,10,12,0" ClipToBounds="True">
                <StackPanel x:Name="Stack" VerticalAlignment="Top"/>
                <TextBox x:Name="Editor" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" SpellCheck.IsEnabled="False"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="{StaticResource Ui.Font}" VerticalAlignment="Stretch"/>
            </Grid>

            <!-- Picture cards: the action row floats on this bar over the image; a plain scrim got lost on bright, busy pictures. -->
            <Border x:Name="Bar" Grid.Row="0" VerticalAlignment="Bottom" Height="34" Margin="6,0,6,6" CornerRadius="10"
                    Background="#E0202428" BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4"/>
                </Border.Effect>
            </Border>

            <!-- One reserved action row: state chips on the left (shown when set), actions on the right (on hover). -->
            <Grid x:Name="Row" Grid.Row="1" Height="28" Margin="5,0,5,3">
                <StackPanel x:Name="Chips" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Overdue ring: pulses a few times, then stays. -->
            <Border x:Name="Ring" Grid.RowSpan="2" CornerRadius="7" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Transient caption (opacity %, 已复制, 外部已修改). -->
            <Border x:Name="Badge" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"
                    Padding="10,3" Background="#B0000000" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
