<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="../../src/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../src/UI/Layout.cs;../../src/UI/Native.cs;../../src/UI/Palette.cs" LinkBase="UI" />
    <EmbeddedResource Include="../../builtin/**/*.json;../../builtin/**/*.md" LogicalName="builtin/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
