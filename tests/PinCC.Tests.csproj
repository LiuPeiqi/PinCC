<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test harness for the pure modules. Run: dotnet run (in this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>../src/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="../src/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../src/UI/Layout.cs;../src/UI/Native.cs" LinkBase="UI" />
    <None Include="../src/app.manifest" />
    <EmbeddedResource Include="../builtin/**/*.json;../builtin/**/*.md" LogicalName="builtin/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
